# Driftwatch configuration — copy to .env / export before serve.py. All optional in replay mode.

# replay (default: recorded Bright Data envelopes + mirror site) | live (real Scraper Studio via CLI)
DW_MODE=replay

# SQLite file (default: ./driftwatch.db). Postgres swap is a driver change — see ARCHITECTURE.md.
# DW_DB_PATH=

# DW_PORT=8000

# Bind address. Default is 127.0.0.1 (localhost only). Set 0.0.0.0 explicitly to
# expose beyond localhost — do this only alongside DW_API_TOKEN below.
# DW_HOST=127.0.0.1

# Optional: requires `Authorization: Bearer <token>` on every /api/* route (the SPA,
# /assets/*, and /mirror/* stay public). Unset = today's open-localhost-demo behaviour.
# DW_API_TOKEN=

# Required for DW_MODE=live — from https://brightdata.com/cp/setting/users
# BRIGHTDATA_API_KEY=

# Optional: upgrades alert prose + migration notes (decisions stay deterministic)
# ANTHROPIC_API_KEY=

# Optional: Class 3/4/5 alerts also post here
# DW_SLACK_WEBHOOK=https://hooks.slack.com/services/...
